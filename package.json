{
  "name": "reclaim-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Reclaim — AI Revenue Recovery Agent · Razorpay AI Buildathon 2026",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:server": "pnpm --filter server dev",
    "dev:worker": "pnpm --filter server dev:worker",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "postinstall": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:generate": "pnpm --filter server db:generate",
    "db:push": "pnpm --filter server db:push",
    "db:seed": "pnpm --filter server db:seed",
    "agent:run-batch": "pnpm --filter server agent:run-batch",
    "test": "pnpm --filter server test",
    "test:frontend": "pnpm --filter client test",
    "test:coverage": "pnpm --filter server test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:all": "pnpm test && pnpm test:frontend && pnpm run test:e2e",
    "eval:batch": "pnpm --filter server eval:batch",
    "lint": "eslint . && pnpm --filter server lint:tsc && pnpm --filter client lint:tsc",
    "lint:eslint": "eslint .",
    "lint:types": "pnpm --filter server lint:tsc && pnpm --filter client lint:tsc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-Madhukar/Reclaim.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mr-Madhukar/Reclaim/issues"
  },
  "homepage": "https://github.com/Mr-Madhukar/Reclaim#readme",
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
