generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPS_VIEWER
  REVIEWER
}

enum Lane {
  PAYMENT
  CHECKOUT
  RECEIVABLE
}

enum CaseStatus {
  OPEN
  RECOVERED
  STOPPED_MAX_ATTEMPTS
  STOPPED_OPTED_OUT
  ESCALATED_TO_HUMAN
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CheckoutStatus {
  ACTIVE
  ABANDONED
  RECOVERED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(OPS_VIEWER)
  merchantId   String?
  merchant     Merchant?   @relation(fields: [merchantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  accessLogs   AccessLog[]

  @@index([email])
}

model Merchant {
  id               String         @id @default(uuid())
  name             String
  timezone         String         @default("Asia/Kolkata")
  contactHourStart Int            @default(9)
  contactHourEnd   Int            @default(19)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  users            User[]
  customers        Customer[]
  policyConfigs    PolicyConfig[]
  recoveryCases    RecoveryCase[]
}

model Customer {
  id               String            @id @default(uuid())
  merchantId       String
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  optedOut         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  paymentAttempts  PaymentAttempt[]
  checkoutSessions CheckoutSession[]
  invoices         Invoice[]
  recoveryCases    RecoveryCase[]

  @@index([merchantId, optedOut])
  @@index([email])
}

model PaymentAttempt {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId          String
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  failureCode      String?
  failureReasonRaw String?
  paymentMethod    String?
  isMandate        Boolean       @default(false)
  mandateId        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId, status])
  @@index([orderId])
}

model CheckoutSession {
  id           String         @id @default(uuid())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cartValue    Decimal        @db.Decimal(12, 2)
  currency     String         @default("INR")
  itemsJson    Json?
  status       CheckoutStatus @default(ACTIVE)
  startedAt    DateTime       @default(now())
  abandonedAt  DateTime?
  completedAt  DateTime?
  recoveryCode String?

  @@index([customerId, status])
}

model Invoice {
  id            String        @id @default(uuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  amountDue     Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId, status])
  @@index([dueDate])
}

model RecoveryCase {
  id           String           @id @default(uuid())
  merchantId   String
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lane         Lane
  sourceRefId  String           // paymentAttempt.id | checkoutSession.id | invoice.id
  rootCause    String?
  status       CaseStatus       @default(OPEN)
  amount       Decimal          @db.Decimal(12, 2)
  incentiveUsed Decimal         @default(0) @db.Decimal(12, 2)
  openedAt     DateTime         @default(now())
  closedAt     DateTime?
  closedReason String?
  shouldRecover Boolean         @default(true) // Ground-truth tag for precision/recall evaluation
  actions      RecoveryAction[]
  promiseToPay PromiseToPay?

  @@index([status, lane])
  @@index([merchantId, status])
  @@index([customerId])
}

model RecoveryAction {
  id             String       @id @default(uuid())
  caseId         String
  case           RecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionType     String
  channel        String?
  payloadJson    Json
  decisionReason String
  modelUsed      String?      // "rules" | "gemini-2.0-flash" | "fallback_template"
  attemptNumber  Int
  outcome        String?      // "sent" | "blocked" | "failed" | "confirmed" | "held"
  createdAt      DateTime     @default(now())

  @@unique([caseId, actionType, attemptNumber]) // Idempotency
  @@index([caseId, actionType])
  @@index([createdAt])
}

model PromiseToPay {
  id             String       @id @default(uuid())
  caseId         String       @unique
  case           RecoveryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  promisedAmount Decimal      @db.Decimal(12, 2)
  promisedDate   DateTime
  kept           Boolean?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model PolicyConfig {
  id                 String   @id @default(uuid())
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  lane               Lane
  maxAttempts        Int      @default(3)
  cooldownMinutes    Int      @default(60)
  contactHourStart   Int      @default(9)
  contactHourEnd     Int      @default(19)
  maxIncentiveAmount Decimal  @default(500) @db.Decimal(12, 2)
  dailyCapGlobal     Int      @default(500)
  updatedAt          DateTime @updatedAt

  @@unique([merchantId, lane])
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      String   // "agent" | "system" | "human:<userId>"
  entityType String   // "RecoveryCase" | "RecoveryAction" | "PolicyConfig" | "Webhook"
  entityId   String
  eventType  String   // "case_created" | "root_cause_diagnosed" | "policy_passed" | "policy_blocked" | "action_executed" | "case_recovered" | "case_escalated" | "case_closed"
  beforeJson Json?
  afterJson  Json?
  reason     String
  createdAt  DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([eventType])
  @@index([createdAt])
}

model AccessLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "login_success" | "login_failed" | "token_refresh" | "permission_denied" | "logout"
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}
